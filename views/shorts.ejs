<%- include('partials/header') %>

<main class="container" style="padding-top: 40px; padding-bottom: 80px;">
  <div class="page-header" style="text-align: center; margin-bottom: 40px;">
    <span class="badge" style="background: rgba(255, 107, 107, 0.15); color: #e03131; font-weight: 700; border-radius: 20px; padding: 6px 16px; display: inline-block; margin-bottom: 12px;">🎥 Social Video Strategy</span>
    <h1 style="font-size: 2.5rem; font-family: var(--font-serif); color: var(--navy-dark); margin-bottom: 16px;">Dogfriz YouTube Shorts & Video Hub</h1>
    <p style="max-width: 680px; margin: 0 auto; color: var(--slate-gray); font-size: 1.1rem; line-height: 1.6;">
      Explore our collection of high-converting, educational vertical videos designed for YouTube Shorts, Instagram Reels, and TikTok.
    </p>
  </div>

  <div class="shorts-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; align-items: start;">
    <% shorts.forEach(short => { %>
      <div class="short-card" style="background: white; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.08); overflow: hidden; display: flex; flex-direction: column;">
        
        <!-- Video Preview & Player Container (Vertical 9:16 Aspect Ratio) -->
        <div class="short-media" style="position: relative; width: 100%; aspect-ratio: 9/16; background: #000; overflow: hidden;">
          <% if (short.videoUrl.includes('youtube.com') || short.videoUrl.includes('youtu.be')) { %>
            <iframe src="<%= short.videoUrl %>" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="width: 100%; height: 100%; border: none;"></iframe>
          <% } else { %>
            <video controls poster="<%= short.image %>" preload="metadata" style="width: 100%; height: 100%; object-fit: cover;">
              <source src="<%= short.videoUrl %>" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          <% } %>
          
          <!-- Overlay badge & duration -->
          <div style="position: absolute; top: 16px; left: 16px; background: rgba(0,0,0,0.65); backdrop-filter: blur(8px); color: white; border-radius: 20px; padding: 4px 12px; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 6px;">
            <span>⏱️ <%= short.targetDuration %></span>
          </div>

          <div style="position: absolute; top: 16px; right: 16px; background: #ff0000; color: white; border-radius: 20px; padding: 4px 10px; font-size: 11px; font-weight: 700; text-transform: uppercase;">
            Shorts
          </div>

          <!-- Bottom text overlay preview -->
          <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 24px 16px 16px; background: linear-gradient(to top, rgba(0,0,0,0.9), transparent); color: white;">
            <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 6px; line-height: 1.3; color: #fff;"><%= short.videoTitle %></h4>
            <p style="font-size: 0.85rem; color: rgba(255,255,255,0.85); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 8px;">
              <%= short.videoDesc %>
            </p>
            <span style="font-size: 0.75rem; color: var(--light-blue); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <%= short.hashtags %>
            </span>
          </div>
        </div>

        <!-- Script Details & Storyboard -->
        <div style="padding: 24px; text-align: center;">
          <h3 style="font-size: 1.25rem; font-family: var(--font-serif); color: var(--navy-dark);"><%= short.title.replace(/\s*\(.*\)/g, '') %></h3>
        </div>
      </div>
    <% }); %>
  </div>
</main>

<%- include('partials/footer') %>
