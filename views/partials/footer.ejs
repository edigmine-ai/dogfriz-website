    ⚙️
  </button>

  <div class="admin-modal">
    <div class="admin-modal-content">
      <div class="admin-modal-header">
        <h2 style="font-family: var(--font-serif);">Dogfriz Admin Dashboard</h2>
        <button class="admin-modal-close-btn" style="font-size: 24px; color: var(--slate-gray);">&times;</button>
      </div>
      
      <div style="margin-bottom: 30px;">
        <h3 style="margin-bottom: 12px; font-size: 18px;">Simulation Control Panel</h3>
        <p style="font-size: 14px; color: var(--slate-gray); margin-bottom: 16px;">
          This dashboard lets you control and observe the store's state as you transition from a "Clean Scientific Showcase" (Phase 1) to an "Activated Dropshipping Shop" (Phase 2).
        </p>
        <div style="display: flex; gap: 12px; background-color: var(--light-gray); padding: 16px; border-radius: var(--radius-sm);">
          <div style="flex-grow: 1;">
            <div style="font-weight: 700; font-size: 14px; margin-bottom: 4px;">Active Storefront Mode:</div>
            <div style="font-size: 13px; color: var(--slate-gray);">
              <%= siteMode === 'phase1' 
                  ? 'Phase 1 - Non-transactional scientific landing pages, commerce elements hidden.' 
                  : 'Phase 2 - Active commerce, buy buttons visible, interactive cart drawer enabled.' %>
            </div>
          </div>
          <button class="btn btn-secondary admin-toggle-btn" style="padding: 10px 16px; font-size: 13px;">
            Toggle State
