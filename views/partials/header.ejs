      <a href="/" class="logo">
        <span class="emoji">🐕</span>
        <span class="logo-dog">Dog</span><span class="logo-friz">friz</span>
      </a>

      <nav>
        <ul class="nav-links">
          <li><a href="/" class="<%= activeNav === 'home' ? 'active' : '' %>">Home</a></li>
          <li><a href="/blogs" class="<%= activeNav === 'blogs' ? 'active' : '' %>">Summer Safety Guides</a></li>
          <li><a href="/products" class="<%= activeNav === 'products' ? 'active' : '' %>">Canine Gear Science</a></li>
          <li><a href="/shorts" class="<%= activeNav === 'shorts' ? 'active' : '' %>">YouTube Shorts</a></li>
