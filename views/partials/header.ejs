<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dogfriz | <%= pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-site-mode="<%= siteMode %>">

  <!-- Announcement Bar -->
