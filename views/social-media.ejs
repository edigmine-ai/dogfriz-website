<%- include('partials/header') %>

<main class="container" style="padding-top: 40px; padding-bottom: 80px;">
  <div class="page-header" style="text-align: center; margin-bottom: 50px;">
    <span class="badge" style="background: rgba(255, 107, 107, 0.15); color: #e03131; font-weight: 700; border-radius: 20px; padding: 6px 16px; display: inline-block; margin-bottom: 12px;">📱 Join Our Community</span>
    <h1 style="font-size: 2.5rem; font-family: var(--font-serif); color: var(--navy-dark); margin-bottom: 16px;">Dogfriz Social Media</h1>
